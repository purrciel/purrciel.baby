---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import lab from '../../data/lab.json';

// ✎ список экспериментов — правь src/data/lab.json
const experiments: { title: string; state: string }[] = lab;
---

<Layout
	title="ЛАБ — PURRCIEL.BABY"
	description="Эксперименты и маленькие программы с purrciel.baby."
>
	<div class="flex flex-col gap-8">
		<PageHeader
			eyebrow="раздел"
			title="Лаб"
			description="Эксперименты и мелкие программы. Почти все начинаются как любопытство в воскресенье, а заканчиваются где-то не там."
		/>

		{
			experiments.length > 0 ? (
				<div class="box">
					<ul class="m-0 flex list-none flex-col gap-4 p-0">
						{experiments.map((project) => (
							<li class="flex items-baseline justify-between gap-4">
								<span class="text-[1.1rem] text-ink">* {project.title}</span>
								<span class="meta shrink-0">
									{project.state === 'done' ? 'готово' : 'в работе'}
								</span>
							</li>
						))}
					</ul>
				</div>
			) : (
				<p class="text-soft">Пока пусто. Эксперименты появятся здесь.</p>
			)
		}

		<p class="meta">Раздел только начинается.</p>
	</div>
</Layout>
