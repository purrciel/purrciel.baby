---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTrack } from '../utils/audio';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Широкий столбец. */
	wide?: boolean;
	/** Главная сама управляет раскладкой (сцена на весь экран). */
	bleed?: boolean;
}

const {
	title = 'PURRCIEL.BABY',
	description = 'Маленький личный мир: сад заметок, лаборатория и пиксельный кот.',
	wide = false,
	bleed = false,
} = Astro.props;

const width = wide ? 'max-w-4xl' : 'max-w-3xl';
const mainClass = bleed
	? 'flex-1'
	: `mx-auto w-full flex-1 px-4 py-10 sm:px-6 sm:py-14 ${width}`;

// Фоновая музыка: первый аудиофайл из src/assets/audio/ (см. utils/audio.ts).
const track = getTrack();
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link
			rel="preload"
			href="/fonts/pixelify-sans-400.ttf"
			as="font"
			type="font/ttf"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/press-start-2p.ttf"
			as="font"
			type="font/ttf"
			crossorigin="anonymous"
		/>
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#content"
			class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:border-4 focus:border-line focus:bg-paper focus:px-3 focus:py-2 focus:text-sm"
		>
			К содержимому
		</a>

		<Header />

		<main id="content" class={mainClass}>
			<slot />
		</main>

		<Footer track={track} music={!bleed} />

		<script>
			// --- меню с сердечком-душой -----------------------------------------
			document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
				const items = Array.from(menu.querySelectorAll<HTMLElement>('.choice'));
				if (!items.length) return;

				const horizontal = menu.getAttribute('data-menu') === 'h';
				let index = 0;

				const setActive = (n: number) => {
					index = (n + items.length) % items.length;
					items.forEach((el, k) => el.toggleAttribute('data-active', k === index));
				};

				setActive(0);
				menu.setAttribute('data-ready', '');

				menu.addEventListener('keydown', (event) => {
					const step = horizontal
						? event.key === 'ArrowRight'
							? 1
							: event.key === 'ArrowLeft'
								? -1
								: 0
						: event.key === 'ArrowDown'
							? 1
							: event.key === 'ArrowUp'
								? -1
								: 0;
					if (!step) return;
					event.preventDefault();
					setActive(index + step);
					items[index]?.focus();
				});

				items.forEach((el, k) => {
					el.addEventListener('focus', () => setActive(k));
					el.addEventListener('pointerenter', () => setActive(k));
				});
			});
		</script>
	</body>
</html>
